# DocuSeal Pro — production environment.
# Copy to .env and fill in. Never commit .env (it is gitignored).

# ---- Required ---------------------------------------------------------------

# Public hostname, no scheme. Used for URLs in emails and signing links.
HOST=sign.example.com

# Signing/encryption key. Generate once and NEVER change it:
#   openssl rand -hex 64
# Rotating this invalidates all sessions, 2FA secrets and encrypted columns.
# It also derives the embedded Redis password and ENCRYPTION_SECRET.
SECRET_KEY_BASE=

# Postgres password used by both the app and the postgres container.
POSTGRES_PASSWORD=

# ---- Optional: database -----------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_DB=docuseal

# To use an external Postgres (Supabase, RDS, Neon) instead of the bundled
# container, set DATABASE_URL directly in docker-compose.prod.yml and drop the
# postgres service. Use a SESSION-mode pooler or a direct connection — Rails
# needs prepared statements and advisory locks, which transaction-mode
# pgBouncer (Supabase port 6543) breaks.

# ---- Optional: concurrency --------------------------------------------------

# Connections used per app process = RAILS_MAX_THREADS + SIDEKIQ_THREADS.
RAILS_MAX_THREADS=15
SIDEKIQ_THREADS=5
# 0 = single Puma process (embedded Sidekiq + Redis). Raise only with RAM to spare.
WEB_CONCURRENCY=0

# ---- Optional: email --------------------------------------------------------
# Without SMTP the app cannot send signing invitations.

SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DOMAIN=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=auto

# ---- Optional: object storage ----------------------------------------------
# Default is the local disk volume. For S3-compatible storage set these and
# switch Active Storage to the aws_s3 service.

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_ATTACHMENTS_BUCKET=
# S3_ENDPOINT=

# ---- Optional: self-serve sign-up -------------------------------------------

# Opens public registration at /registration/new, where anyone can create their
# own account (tenant) and become its admin. Required for SaaS; leave unset for
# a private instance, where users are invited by an admin instead.
# SIGNUP_ENABLED=true

# ---- Optional: misc ---------------------------------------------------------

# Protects the /sidekiq dashboard with HTTP basic auth. Leave empty to disable
# the dashboard entirely in production.
SIDEKIQ_BASIC_AUTH_PASSWORD=
