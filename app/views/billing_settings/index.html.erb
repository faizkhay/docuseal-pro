<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-xl mx-auto">
    <h1 class="text-4xl font-bold mb-4">
      <%= t('billing') %>
    </h1>

    <% if Billing.mock_provider? %>
      <div class="alert alert-warning mb-6">
        <span><%= t('billing_mock_provider_notice') %></span>
      </div>
    <% end %>

    <div class="border border-base-300 rounded-lg p-4 mb-8">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-sm opacity-70"><%= t('billing_current_plan') %></div>
          <div class="text-2xl font-bold"><%= @subscription.title %></div>
        </div>
        <div class="text-right">
          <div class="text-sm opacity-70"><%= t('status') %></div>
          <div class="font-medium"><%= @subscription.status.humanize %></div>
        </div>
      </div>
      <% if @subscription.current_period_end %>
        <div class="text-sm opacity-70 mt-2">
          <%= t('billing_renews_on', date: l(@subscription.current_period_end.to_date, format: :long)) %>
        </div>
      <% end %>
    </div>

    <h2 class="text-3xl font-bold mb-4"><%= t('billing_plans') %></h2>
    <div class="space-y-3">
      <% @plans.each do |plan_id, plan| %>
        <% current = plan_id == @subscription.plan_id %>
        <div id="plan_<%= plan_id %>" class="border rounded-lg p-4 <%= current ? 'border-base-content' : 'border-base-300' %>">
          <div class="flex items-center justify-between gap-4">
            <div>
              <div class="text-xl font-bold">
                <%= plan[:title] %>
                <% if current %>
                  <span class="badge badge-neutral ml-1"><%= t('billing_current_plan') %></span>
                <% end %>
              </div>
              <div class="text-sm opacity-70">
                <%= Billing.price(plan_id) %><%= " / #{t('billing_per_month')}" if plan[:price_cents].positive? %>
              </div>
              <ul class="text-sm opacity-70 mt-2 list-disc list-inside">
                <li>
                  <%= plan[:documents_per_month] ? t('billing_documents_per_month', count: plan[:documents_per_month]) : t('billing_unlimited_documents') %>
                </li>
                <li>
                  <%= plan[:users] ? t('billing_users_included', count: plan[:users]) : t('billing_unlimited_users') %>
                </li>
              </ul>
            </div>
            <div class="flex-none">
              <% if current %>
                <% if plan_id != Billing::DEFAULT_PLAN_ID %>
                  <%= button_to t('billing_cancel_plan'), cancel_settings_billing_index_path, method: :delete, class: 'base-button btn-outline', form: { data: { turbo_confirm: t('are_you_sure_') } } %>
                <% end %>
              <% else %>
                <%= button_to t('billing_choose_plan'), settings_billing_index_path, method: :post, params: { plan_id: plan_id }, class: 'base-button' %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
