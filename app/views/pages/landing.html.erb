<section class="flex items-center justify-center">
  <div class="py-10 mx-auto max-w-7xl">
    <div class="max-w-xl mx-auto">
      <div class="text-center">
        <div class="relative flex flex-col items-center">
          <%= render 'shared/logo', width: '100', height: '100' %>
          <h1 class="text-6xl font-bold mt-4 mb-4">
            <%= Docuseal.product_name %>
          </h1>
          <% if Docuseal.version.present? %>
            <span class="badge badge-outline badge-lg block mx-auto">
              v<%= Docuseal.version %>
            </span>
          <% end %>
        </div>
        <h2 class="mt-4 mb-8 text-lg text-center text-gray-600">
          <%= t('document_signing_description') %>
        </h2>
        <div class="flex items-center justify-center gap-3 mb-16">
          <%= link_to t('sign_in'), new_user_session_path, class: 'base-button' %>
          <% if Docuseal.signup_enabled? %>
            <%= link_to t('sign_up'), new_registration_path, class: 'white-button' %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-12 md:gap-10 md:grid-cols-2">
      <div class="card bg-base-200">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 bg-primary rounded-full">
              <%= svg_icon('writing_sign', class: 'w-10 h-10 text-base-100 stroke-1') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold">Build Once, Send Forever</h3>
            <p class="text-base text-gray-500">
              Drop in a PDF and place signature, date, checkbox and file fields with a
              visual builder. Reuse the template for every recipient after that.
            </p>
          </div>
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 bg-primary rounded-full">
              <%= svg_icon('devices', class: 'w-10 h-10 text-base-100') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold">Signs on Any Device</h3>
            <p class="text-base text-gray-500">
              Recipients open a link and sign in the browser, on a phone or a laptop.
              Nothing to install and no account required to sign.
            </p>
          </div>
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 bg-primary rounded-full">
              <%= svg_icon('shield_check', class: 'w-10 h-10 text-base-100') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold">Verifiable Signatures</h3>
            <p class="text-base text-gray-500">
              Every completed document is signed with a digital certificate and carries
              an audit trail of who opened, filled and signed it, and when.
            </p>
          </div>
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 bg-primary rounded-full">
              <%= svg_icon('code', class: 'w-10 h-10 text-base-100') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold">API and Webhooks</h3>
            <p class="text-base text-gray-500">
              A REST API and webhooks for every step of the signing lifecycle, plus an
              embeddable form so signing can happen inside your own product.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<%= render 'shared/attribution', with_counter: true %>
